# Copiar a .env.local y completar con Project Settings > API / Connect.
# NEXT_PUBLIC_* se incorpora al navegador durante el build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternativa para proyectos con claves antiguas:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# supabase para usuarios reales; demo para el prototipo local sin conexión.
NEXT_PUBLIC_AUTH_MODE=supabase

# No colocar claves service_role, sb_secret ni contraseñas de PostgreSQL aquí.
